PORT=5000

# Para sa Neon / Cloud PostgreSQL:
# I-paste dito ang Connection String mula sa Neon Dashboard (e.g. postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# O kung gagamit ng local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=synclink_db
DB_SSL=false

JWT_SECRET=change_this_to_a_long_random_secret
UPLOAD_DIR=uploads/videos
MAX_VIDEO_SIZE_MB=50

